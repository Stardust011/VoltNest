{
  "name": "voltnest-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VoltNest desktop shell (Vue 3 + Vite + Tauri 2)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "npm run format:rust && npm run format:web",
    "format:check": "npm run format:check:rust && npm run format:check:web",
    "format:rust": "cargo fmt --all --manifest-path ../../Cargo.toml",
    "format:check:rust": "cargo fmt --all --manifest-path ../../Cargo.toml --check",
    "format:web": "prettier --write .",
    "format:check:web": "prettier --check .",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/vue": "^1.60.0",
    "@tauri-apps/api": "^2.1.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.4.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}

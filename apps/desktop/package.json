{
  "name": "voltnest-desktop",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "description": "VoltNest desktop shell (Vue 3 + Vite + Tauri 2)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "pnpm run format:rust && pnpm run format:web && pnpm run format:repo && pnpm run format:py",
    "format:check": "pnpm run format:check:rust && pnpm run format:check:web && pnpm run format:check:repo && pnpm run format:check:py",
    "format:rust": "cargo fmt --all --manifest-path ../../Cargo.toml",
    "format:check:rust": "cargo fmt --all --manifest-path ../../Cargo.toml --check",
    "format:web": "prettier --write .",
    "format:check:web": "prettier --check .",
    "format:repo": "cd ../.. && prettier --write .",
    "format:check:repo": "cd ../.. && prettier --check .",
    "format:py": "cd ../.. && ruff format .",
    "format:check:py": "cd ../.. && ruff format --check .",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/vue": "^1.62.0",
    "@tauri-apps/api": "^2.1.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.4.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}

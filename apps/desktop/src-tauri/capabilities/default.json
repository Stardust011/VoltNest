{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的最小权限集：事件订阅、低电量 Toast，以及自绘标题栏需要的窗口操作。最小化到托盘与退出都由宿主命令完成，前端不再持有 minimize/close 权限。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "notification:default"
  ]
}

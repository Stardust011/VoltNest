{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoltNest",
  "version": "0.3.1",
  "identifier": "VoltNest.Desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:5273",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoltNest",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "visible": false,
        "skipTaskbar": false,
        "decorations": false,
        "shadow": true,
        "devtools": false,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../crates/voltnest-hid/data/mappings/*.json": "mappings/"
    },
    "publisher": "VoltNest",
    "shortDescription": "外设电量监控",
    "longDescription": "统一展示 2.4G 接收器与蓝牙设备的电量，读数过期时逐级退化而不假装仍有效。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "nsis/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}

// VoltNest 桌面悬浮窗界面。
//
// 外形是圆角正方形卡片：无投影，窗口平时与卡片同尺寸，不留白边。
// 卡面上只画一个进度圆环，环内是设备类型的标志（Lucide 图标，ISC 许可）。
// 玻璃质感由半透明渐变底 + 顶缘高光 + 1px 细边叠加而成，全部在渲染层完成。
// 整卡按 `k = card-side / 180` 等比缩放，改尺寸即整体缩放，布局不会走形。
// 右键菜单是自绘面板（原生菜单放不下滑块）：窗口在展开时临时扩成「卡片 ∪ 面板」，
// 卡片靠 card-x / card-y 抵消窗口位移，所以视觉上不会移动。

import { Palette, Slider } from "std-widgets.slint";

// Lucide 图标统一封装：24×24 viewBox，描边 2，圆头圆角。
//
// 描边用元素像素而不是 viewbox 单位（Slint 只按 viewbox 缩放几何、不缩放描边），
// 所以按「2/24 × 边长」= 边长 / 12 推导，尺寸与描边只维护 `side` 一个数。
component TypeIcon inherits Path {
    in property <string> d: "";
    in property <color> tint: #000;
    in property <length> side: 58px;

    width: self.side;
    height: self.side;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    stroke-width: self.side / 12;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: self.d;
}

// 环内的设备类型标志：按 device-type 选一个图标，认不出的类型退回问号。
//
// 各图标的原始 SVG 图元（rect / circle / line / path）已展开成单条 path 命令。
component DeviceGlyph inherits Rectangle {
    in property <string> kind: "mouse";
    in property <color> ink: #000;
    in property <float> k: 1;

    width: 58px * self.k;
    height: 58px * self.k;

    property <bool> is-gamepad: kind == "gamepad" || kind == "controller";
    property <bool> is-headset: kind == "headset" || kind == "headphones";
    property <bool> known: kind == "mouse" || kind == "keyboard" || is-gamepad
        || is-headset || kind == "speaker";

    // mouse: rect(5,2,14,20,r7) + 竖线
    TypeIcon {
        visible: root.kind == "mouse";
        side: root.width;
        tint: root.ink;
        d: "M 12 2 A 7 7 0 0 1 19 9 L 19 15 A 7 7 0 0 1 12 22 A 7 7 0 0 1 5 15 L 5 9 A 7 7 0 0 1 12 2 Z M 12 6 L 12 10";
    }

    // keyboard: 外框 + 一排按键点 + 空格键
    TypeIcon {
        visible: root.kind == "keyboard";
        side: root.width;
        tint: root.ink;
        d: "M 10 8 L 10.01 8 M 12 12 L 12.01 12 M 14 8 L 14.01 8 M 16 12 L 16.01 12 M 18 8 L 18.01 8 M 6 8 L 6.01 8 M 7 16 L 17 16 M 8 12 L 8.01 12 M 4 4 L 20 4 A 2 2 0 0 1 22 6 L 22 18 A 2 2 0 0 1 20 20 L 4 20 A 2 2 0 0 1 2 18 L 2 6 A 2 2 0 0 1 4 4 Z";
    }

    // gamepad-2: 十字键 + 两个摇杆/按键 + 手柄轮廓
    TypeIcon {
        visible: root.is-gamepad;
        side: root.width;
        tint: root.ink;
        d: "M 6 11 L 10 11 M 8 9 L 8 13 M 15 12 L 15.01 12 M 18 10 L 18.01 10 M 17.32 5 L 6.68 5 A 4 4 0 0 0 2.702 8.59 C 2.696 8.642 2.692 8.691 2.685 8.742 C 2.604 9.416 2 14.456 2 16 A 3 3 0 0 0 5 19 C 6 19 6.5 18.5 7 18 L 8.414 16.586 A 2 2 0 0 1 9.828 16 L 14.172 16 A 2 2 0 0 1 15.586 16.586 L 17 18 C 17.5 18.5 18 19 19 19 A 3 3 0 0 0 22 16 C 22 14.455 21.396 9.416 21.315 8.742 C 21.308 8.692 21.304 8.642 21.298 8.591 A 4 4 0 0 0 17.32 5 Z";
    }

    // headphones: 耳罩 + 头梁
    TypeIcon {
        visible: root.is-headset;
        side: root.width;
        tint: root.ink;
        d: "M 3 14 L 6 14 A 2 2 0 0 1 8 16 L 8 19 A 2 2 0 0 1 6 21 L 5 21 A 2 2 0 0 1 3 19 L 3 12 A 9 9 0 0 1 21 12 L 21 19 A 2 2 0 0 1 19 21 L 18 21 A 2 2 0 0 1 16 19 L 16 16 A 2 2 0 0 1 18 14 L 21 14";
    }

    // speaker: 箱体 + 上下两个单元
    TypeIcon {
        visible: root.kind == "speaker";
        side: root.width;
        tint: root.ink;
        d: "M 6 2 L 18 2 A 2 2 0 0 1 20 4 L 20 20 A 2 2 0 0 1 18 22 L 6 22 A 2 2 0 0 1 4 20 L 4 4 A 2 2 0 0 1 6 2 Z M 12 6 L 12.01 6 M 12 10 A 4 4 0 1 1 11.999 10 Z M 12 14 L 12.01 14";
    }

    // help-circle: 类型未知时的兜底
    TypeIcon {
        visible: !root.known;
        side: root.width;
        tint: root.ink;
        d: "M 12 2 A 10 10 0 1 1 11.999 2 Z M 9.09 9 A 3 3 0 0 1 14.92 10 C 14.92 12 11.92 13 11.92 13 M 12 17 L 12.01 17";
    }
}

// 右下角缩放手柄：悬停才显形的两条斜线，按住拖动改变窗口尺寸。
component ResizeGrip inherits Rectangle {
    callback grab();
    callback release();
    callback moved-to(length, length);
    in property <color> ink: #000;
    in property <float> k: 1;
    property <bool> hovered: false;

    width: 34px * self.k;
    height: 34px * self.k;
    background: transparent;

    Path {
        width: 18px * root.k;
        height: 18px * root.k;
        x: parent.width - self.width - 3px * root.k;
        y: parent.height - self.height - 3px * root.k;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: "M 6 17 L 17 6 M 13 17 L 17 13";
        stroke: root.ink;
        stroke-width: 1.6px * root.k;
        stroke-line-cap: round;
        opacity: root.hovered ? 0.6 : 0;
        animate opacity { duration: 140ms; }
    }

    TouchArea {
        mouse-cursor: nwse-resize;
        changed has-hover => { root.hovered = self.has-hover; }
        changed pressed => {
            if (self.pressed) {
                root.grab();
            } else {
                root.release();
            }
        }
        // 上报相对窗口左上角的坐标：窗口左上角在缩放时不动，位移可直接换算成尺寸增量。
        moved => { root.moved-to(root.x + self.mouse-x, root.y + self.mouse-y); }
    }
}
export component MainWindow inherits Window {
    // 设备类型，取值与 `voltnest-provider` 的 `DeviceType::as_str()` 一致。
    in property <string> device-type: "mouse";
    // 右键菜单里的三行详细信息。
    in property <string> device-name: "MCHOSE A5 Pro";
    in property <string> device-battery: "87%";
    in property <string> device-status: "已连接 · 蓝牙";
    // 0.0 ~ 1.0，圆环的进度。
    in property <float> level: 0.87;

    // 卡片边长（逻辑像素）由 Rust 维护。右键菜单展开时窗口会比卡片大，
    // 卡片靠 card-x / card-y 定位，这样面板可以摆在卡片四周而不移动卡片。
    in-out property <length> card-side: 180px;
    in property <length> card-x: 0px;
    in property <length> card-y: 0px;
    // 右键菜单：是否展开 + 面板在窗口内的位置（由 Rust 算好，保证不出屏）。
    in-out property <bool> menu-open: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    // 透明度 0~100（100 最透），只作用于卡片玻璃底，图标与文字保持不透明。
    in-out property <float> transparency: 0;

    // 拖拽：press 时通知 Rust 建立锚点，move 时上报指针在卡片内的逻辑坐标。
    callback drag-begin();
    callback drag-move(length, length);
    callback drag-end();
    // 缩放：按下瞬间由 Rust 记录基准尺寸，之后只上报相对位移。
    callback resize-begin();
    callback resize-move(length, length);
    callback resize-end();
    // 菜单展开：把「卡片内」的点击坐标交给 Rust，由它算窗口与面板的位置。
    callback menu-open-requested(length, length);
    // 菜单收起（点空白 / 再点右键 / 开始拖拽缩放）：Rust 据此把窗口缩回卡片大小。
    callback menu-closed();
    callback close-requested();

    title: "VoltNest";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    // 初始尺寸由 Rust 端设置；这里不绑 width/height，
    // 否则会成为常量绑定、挡住系统缩放带来的尺寸回写。

    // 等比缩放系数：所有尺寸都以 180×180 为基准乘以它。
    property <float> k: root.card-side / 180px;
    property <length> radius: 40px * root.k;
    // 玻璃底的不透明度：transparency 100 时降到 25%，环与图标不受影响。
    property <float> glass: 1 - root.transparency / 100 * 0.75;
    // 按下并进入拖拽状态后才响应移动，避免悬停时的 pointer-event 误移动窗口。
    property <bool> dragging: false;

    property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    property <color> ink: dark ? rgba(255, 255, 255, 0.95) : rgba(23, 24, 28, 0.92);
    property <color> ink-dim: dark ? rgba(255, 255, 255, 0.58) : rgba(23, 24, 28, 0.55);
    property <color> hairline: dark ? rgba(255, 255, 255, 0.12) : rgba(18, 20, 30, 0.10);

    // 进度环几何：view box 100×100，圆心 (50, 50)。图标与环一起随 k 缩放。
    property <float> ring-r: 44;
    property <float> ring-c: 50;
    property <float> ring-end-x: root.ring-c + root.ring-r * cos(-90deg + root.level * 360deg);
    property <float> ring-end-y: root.ring-c + root.ring-r * sin(-90deg + root.level * 360deg);

    // 圆角矩形距离场：0 表示还在直边范围内，正数表示越过圆角外扩了多远。
    // 用它把「可拖拽范围」限制在可见的圆角卡片上，而不是整个矩形窗口。
    function shoulder(offset: length, edge: length) -> float {
        return max(max(root.radius - offset, 0px), offset - (edge - root.radius)) / 1px;
    }
    function inside-card(px: length, py: length) -> bool {
        return root.shoulder(px, root.card-side) * root.shoulder(px, root.card-side)
            + root.shoulder(py, root.card-side) * root.shoulder(py, root.card-side)
            <= (root.radius / 1px) * (root.radius / 1px);
    }

    // 收起菜单并让 Rust 把窗口缩回去。
    function close-menu() {
        if (root.menu-open) {
            root.menu-open = false;
            root.menu-closed();
        }
    }

    // 菜单展开时铺满窗口的透明层：点卡片以外的地方收起。
    // 放在最底层，卡片与面板都在它上面，因此不会抢它们的手势。
    TouchArea {
        visible: root.menu-open;
        clicked => { root.close-menu(); }
    }

    // 卡片：位置由 Rust 给出（通常是窗口左上角）。
    card := Rectangle {
        x: root.card-x;
        y: root.card-y;
        width: root.card-side;
        height: root.card-side;
        border-radius: root.radius;
        background: @linear-gradient(
            155deg,
            (dark ? #2c2e36 : #ffffff).with-alpha(0.97 * root.glass),
            (dark ? #14151b : #f0f2f9).with-alpha(0.90 * root.glass)
        );
        border-width: 1px;
        border-color: dark ? rgba(255, 255, 255, 0.16) : rgba(18, 20, 30, 0.10);

        // 顶缘高光：一层垂直淡出的白色渐变，模拟玻璃受光。
        Rectangle {
            border-radius: parent.border-radius;
            background: @linear-gradient(
                180deg,
                rgba(255, 255, 255, (dark ? 0.12 : 0.55) * root.glass) 0%,
                rgba(255, 255, 255, 0.0) 40%
            );
        }

        // 圆环 + 环内类型图标，整体居中。
        Rectangle {
            width: 122px * root.k;
            height: 122px * root.k;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            // 底环
            Path {
                viewbox-width: 100;
                viewbox-height: 100;
                commands: "M 50 6 A 44 44 0 1 1 49.9 6 Z";
                stroke: dark ? rgba(255, 255, 255, 0.16) : rgba(23, 24, 28, 0.10);
                stroke-width: 7.5px * root.k;
            }

            // 进度弧：从 12 点方向顺时针画到 level 对应的角度。
            Path {
                viewbox-width: 100;
                viewbox-height: 100;
                commands: "M \{root.ring-c} \{root.ring-c - root.ring-r} A \{root.ring-r} \{root.ring-r} 0 \{root.level > 0.5 ? 1 : 0} 1 \{root.ring-end-x} \{root.ring-end-y}";
                stroke: @linear-gradient(120deg, #6366f1, #a855f7);
                stroke-width: 7.5px * root.k;
                stroke-line-cap: round;
            }

            DeviceGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                kind: root.device-type;
                ink: root.ink;
                k: root.k;
            }
        }

        // 拖拽层覆盖整卡；落在圆角外的透明区域不响应。置于内容之上、手柄之下。
        TouchArea {
            mouse-cursor: root.inside-card(self.mouse-x, self.mouse-y) ? MouseCursor.move : MouseCursor.default;
            pointer-event(event) => {
                if (root.menu-open) {
                    // 菜单开着时，点卡片本身就是「点空白」：先收起。
                    if (event.kind == PointerEventKind.down) {
                        root.close-menu();
                    }
                } else if (event.kind == PointerEventKind.down) {
                    // 左键拖拽、右键开菜单，都要落在可见卡片内；圆角外的透明区不响应。
                    if (event.button == PointerEventButton.right
                        && root.inside-card(self.mouse-x, self.mouse-y)) {
                        root.menu-open = true;
                        root.menu-open-requested(self.mouse-x, self.mouse-y);
                    } else if (event.button == PointerEventButton.left
                        && root.inside-card(self.mouse-x, self.mouse-y)) {
                        root.dragging = true;
                        root.drag-begin();
                    }
                } else if (event.kind == PointerEventKind.up) {
                    if (root.dragging) {
                        root.dragging = false;
                        root.drag-end();
                    }
                } else if (event.kind == PointerEventKind.move) {
                    if (root.dragging) {
                        root.drag-move(self.mouse-x, self.mouse-y);
                    }
                }
            }
        }

        ResizeGrip {
            x: parent.width - self.width;
            y: parent.height - self.height;
            k: root.k;
            ink: root.ink-dim;
            grab() => { root.close-menu(); root.resize-begin(); }
            moved-to(x, y) => { root.resize-move(x, y); }
            release() => { root.resize-end(); }
        }
    }

    // 右键菜单面板：固定 196×180（Rust 侧 MENU_W / MENU_H 必须一致）。
    // 原生菜单放不下滑块，所以这里自绘：玻璃底 + 分隔线 + 自定义行。
    menu := Rectangle {
        visible: root.menu-open;
        x: root.menu-x;
        y: root.menu-y;
        width: 196px;
        height: 180px;
        border-radius: 14px;
        background: (dark ? #23252c : #ffffff).with-alpha(0.98);
        border-width: 1px;
        border-color: dark ? rgba(255, 255, 255, 0.14) : rgba(18, 20, 30, 0.09);

        // 面板背景要吞掉点击，否则点空白行会穿透到底层的「点空白收起」。
        TouchArea { }

        VerticalLayout {
            padding: 12px;
            spacing: 6px;

            // 透明度：标题 + 百分比
            HorizontalLayout {
                height: 16px;
                Text {
                    text: "透明度";
                    font-size: 11px;
                    color: root.ink-dim;
                    vertical-alignment: center;
                }
                Rectangle { }
                Text {
                    text: round(root.transparency) + "%";
                    font-size: 11px;
                    color: root.ink;
                    vertical-alignment: center;
                }
            }

            Slider {
                height: 22px;
                minimum: 0;
                maximum: 100;
                value <=> root.transparency;
            }

            Rectangle { height: 1px; background: root.hairline; }

            Text {
                height: 16px;
                text: "设备：" + root.device-name;
                font-size: 11px;
                color: root.ink-dim;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                height: 16px;
                text: "电量：" + root.device-battery;
                font-size: 11px;
                color: root.ink-dim;
                vertical-alignment: center;
            }
            Text {
                height: 16px;
                text: "状态：" + root.device-status;
                font-size: 11px;
                color: root.ink-dim;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle { height: 1px; background: root.hairline; }

            // 退出
            Rectangle {
                height: 26px;
                border-radius: 7px;
                background: exit.has-hover ? rgba(239, 68, 68, dark ? 0.22 : 0.12) : transparent;

                exit := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close-requested(); }
                }

                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: "退出";
                    font-size: 11px;
                    color: exit.has-hover ? (dark ? rgba(255, 170, 170, 0.95) : rgba(185, 28, 28, 0.92)) : root.ink;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// VoltNest 桌面悬浮窗界面。
//
// 外形是圆角正方形卡片：无投影，窗口与卡片同尺寸，不留白边。
// 玻璃质感由半透明渐变底 + 顶缘高光 + 1px 细边叠加而成，全部在渲染层完成。
// 图标是「进度圆环 + 设备标志」：环用 SVG 圆弧绘制，端点由三角函数按电量算出。

import { Palette } from "std-widgets.slint";

// 悬停才浮出圆底的关闭按钮。
component CloseButton inherits Rectangle {
    callback closed();
    in property <color> glyph: #000;
    property <bool> hovered: false;

    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: hovered ? glyph.with-alpha(0.14) : transparent;
    animate background { duration: 140ms; }

    Path {
        width: 9px;
        height: 9px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 1 1 L 9 9 M 9 1 L 1 9";
        stroke: root.glyph;
        stroke-width: 1.4px;
        stroke-line-cap: round;
    }

    TouchArea {
        mouse-cursor: pointer;
        changed has-hover => { root.hovered = self.has-hover; }
        clicked => { root.closed(); }
    }
}

// 设备标志：鼠标轮廓 + 滚轮。用纯几何绘制，不依赖图标字体。
component DeviceGlyph inherits Rectangle {
    in property <color> ink: #000;

    width: 24px;
    height: 34px;
    border-radius: 12px;
    border-width: 1.8px;
    border-color: ink;
    background: transparent;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 5px;
        width: 2px;
        height: 8px;
        border-radius: 1px;
        background: root.ink;
    }
}

export component MainWindow inherits Window {
    // 主数值（如电量百分比）与其说明文字。
    in property <string> headline: "87%";
    in property <string> caption: "VoltNest · 已连接 2 台";
    // 0.0 ~ 1.0，圆环的进度。
    in property <float> level: 0.87;

    // 拖拽：press 时通知 Rust 建立锚点，move 时上报指针在窗口内的逻辑坐标。
    callback drag-begin();
    callback drag-move(length, length);
    callback drag-end();
    callback close-requested();

    title: "VoltNest";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 180px;
    height: 180px;

    property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    property <color> ink: dark ? rgba(255, 255, 255, 0.95) : rgba(23, 24, 28, 0.92);
    property <color> ink-dim: dark ? rgba(255, 255, 255, 0.58) : rgba(23, 24, 28, 0.55);

    // 进度环几何：view box 与控件同为 92×92，圆心 (46, 46)。
    property <float> ring-r: 42;
    property <float> ring-c: 46;
    property <float> ring-end-x: root.ring-c + root.ring-r * cos(-90deg + root.level * 360deg);
    property <float> ring-end-y: root.ring-c + root.ring-r * sin(-90deg + root.level * 360deg);

    // 卡片铺满窗口：没有投影就不需要留白，圆角靠窗口的透明区域让出。
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 40px;
        background: @linear-gradient(
            155deg,
            dark ? rgba(42, 44, 52, 0.94) : rgba(255, 255, 255, 0.94),
            dark ? rgba(20, 21, 27, 0.86) : rgba(238, 240, 248, 0.84)
        );
        border-width: 1px;
        border-color: dark ? rgba(255, 255, 255, 0.16) : rgba(18, 20, 30, 0.10);

        // 顶缘高光：一层垂直淡出的白色渐变，模拟玻璃受光。
        Rectangle {
            border-radius: parent.border-radius;
            background: @linear-gradient(
                180deg,
                rgba(255, 255, 255, dark ? 0.12 : 0.55) 0%,
                rgba(255, 255, 255, 0.0) 40%
            );
        }

        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            alignment: center;
            spacing: 8px;

            HorizontalLayout {
                alignment: center;

                // 圆环 + 设备标志
                Rectangle {
                    width: 92px;
                    height: 92px;

                    // 底环
                    Path {
                        viewbox-width: 92;
                        viewbox-height: 92;
                        commands: "M 46 4 A 42 42 0 1 1 45.9 4 Z";
                        stroke: dark ? rgba(255, 255, 255, 0.16) : rgba(23, 24, 28, 0.10);
                        stroke-width: 6px;
                    }

                    // 进度弧：从 12 点方向顺时针画到 level 对应的角度。
                    Path {
                        viewbox-width: 92;
                        viewbox-height: 92;
                        commands: "M \{root.ring-c} \{root.ring-c - root.ring-r} A \{root.ring-r} \{root.ring-r} 0 \{root.level > 0.5 ? 1 : 0} 1 \{root.ring-end-x} \{root.ring-end-y}";
                        stroke: @linear-gradient(120deg, #6366f1, #a855f7);
                        stroke-width: 6px;
                        stroke-line-cap: round;
                    }

                    DeviceGlyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        ink: root.ink;
                    }
                }
            }

            Text {
                text: root.headline;
                font-size: 21px;
                font-weight: 700;
                color: root.ink;
                horizontal-alignment: center;
            }

            Text {
                text: root.caption;
                font-size: 10px;
                color: root.ink-dim;
                horizontal-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }
        }

        // 拖拽层覆盖整卡；置于内容之上、关闭按钮之下。
        TouchArea {
            mouse-cursor: move;
            changed pressed => {
                if (self.pressed) {
                    root.drag-begin();
                } else {
                    root.drag-end();
                }
            }
            moved => { root.drag-move(self.mouse-x, self.mouse-y); }
        }

        CloseButton {
            x: parent.width - self.width - 12px;
            y: 12px;
            glyph: root.ink-dim;
            closed => { root.close-requested(); }
        }
    }
}

// VoltNest 桌面悬浮窗界面。
//
// 外形是圆角正方形卡片：无投影，窗口与卡片同尺寸，不留白边。
// 玻璃质感由半透明渐变底 + 顶缘高光 + 1px 细边叠加而成，全部在渲染层完成。
// 图标是「进度圆环 + Lucide 设备图标」，环的端点由三角函数按电量算出。
// 整卡按 `k = 窗口宽 / 180` 等比缩放，改窗口大小即整体缩放，布局不会走形。

import { Palette } from "std-widgets.slint";

// Lucide `image` 图标（ISC 许可），24×24 viewBox，描边 2。
// 原始三个图元已展开成一条 path 命令：
//   rect 3,3 18×18 r2                          → 四段圆角折线
//   circle cx9 cy9 r2                          → 两段半圆弧
//   m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21  → 折线 + 圆弧
component LucideImage inherits Path {
    in property <color> ink: #000;
    in property <float> k: 1;

    width: 40px * self.k;
    height: 40px * self.k;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: ink;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M 5 3 L 19 3 A 2 2 0 0 1 21 5 L 21 19 A 2 2 0 0 1 19 21 L 5 21 A 2 2 0 0 1 3 19 L 3 5 A 2 2 0 0 1 5 3 Z M 11 9 A 2 2 0 1 1 7 9 A 2 2 0 1 1 11 9 Z M 21 15 L 17.914 11.914 A 2 2 0 0 0 15.086 11.914 L 6 21";
}

// 左上角关闭按钮：与右下角缩放手柄同一套处理——角上留一块热区，指针进入才显形。
component CloseButton inherits Rectangle {
    callback closed();
    in property <color> ink: #000;
    in property <float> k: 1;
    property <bool> hovered: false;

    width: 34px * self.k;
    height: 34px * self.k;
    background: transparent;

    Path {
        width: 10px * root.k;
        height: 10px * root.k;
        x: 13px * root.k;
        y: 13px * root.k;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 1 1 L 9 9 M 9 1 L 1 9";
        stroke: root.ink;
        stroke-width: 1.6px * root.k;
        stroke-line-cap: round;
        opacity: root.hovered ? 0.6 : 0;
        animate opacity { duration: 140ms; }
    }

    TouchArea {
        mouse-cursor: pointer;
        changed has-hover => { root.hovered = self.has-hover; }
        clicked => { root.closed(); }
    }
}

// 右下角缩放手柄：悬停才显形的两条斜线，按住拖动改变窗口尺寸。
component ResizeGrip inherits Rectangle {
    callback grab();
    callback release();
    callback moved-to(length, length);
    in property <color> ink: #000;
    in property <float> k: 1;
    property <bool> hovered: false;

    width: 34px * self.k;
    height: 34px * self.k;
    background: transparent;

    Path {
        width: 18px * root.k;
        height: 18px * root.k;
        x: parent.width - self.width - 3px * root.k;
        y: parent.height - self.height - 3px * root.k;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: "M 6 17 L 17 6 M 13 17 L 17 13";
        stroke: root.ink;
        stroke-width: 1.6px * root.k;
        stroke-line-cap: round;
        opacity: root.hovered ? 0.6 : 0;
        animate opacity { duration: 140ms; }
    }

    TouchArea {
        mouse-cursor: nwse-resize;
        changed has-hover => { root.hovered = self.has-hover; }
        changed pressed => {
            if (self.pressed) {
                root.grab();
            } else {
                root.release();
            }
        }
        // 上报相对窗口左上角的坐标：窗口左上角在缩放时不动，位移可直接换算成尺寸增量。
        moved => { root.moved-to(root.x + self.mouse-x, root.y + self.mouse-y); }
    }
}

export component MainWindow inherits Window {
    // 主数值（如电量百分比）与其说明文字。
    in property <string> headline: "87%";
    in property <string> caption: "VoltNest · 已连接 2 台";
    // 0.0 ~ 1.0，圆环的进度。
    in property <float> level: 0.87;

    // 拖拽：press 时通知 Rust 建立锚点，move 时上报指针在窗口内的逻辑坐标。
    callback drag-begin();
    callback drag-move(length, length);
    callback drag-end();
    // 缩放：按下瞬间由 Rust 记录基准尺寸，之后只上报相对位移。
    callback resize-begin();
    callback resize-move(length, length);
    callback resize-end();
    callback close-requested();

    title: "VoltNest";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 180px;
    height: 180px;

    // 等比缩放系数：所有尺寸都以 180×180 为基准乘以它。
    property <float> k: root.width / 180px;
    property <length> radius: 40px * root.k;
    // 按下并进入拖拽状态后才响应移动，避免悬停时的 pointer-event 误移动窗口。
    property <bool> dragging: false;

    property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    property <color> ink: dark ? rgba(255, 255, 255, 0.95) : rgba(23, 24, 28, 0.92);
    property <color> ink-dim: dark ? rgba(255, 255, 255, 0.58) : rgba(23, 24, 28, 0.55);

    // 进度环几何：view box 92×92，圆心 (46, 46)。图标与环一起随 k 缩放。
    property <float> ring-r: 42;
    property <float> ring-c: 46;
    property <float> ring-end-x: root.ring-c + root.ring-r * cos(-90deg + root.level * 360deg);
    property <float> ring-end-y: root.ring-c + root.ring-r * sin(-90deg + root.level * 360deg);

    // 圆角矩形距离场：0 表示还在直边范围内，正数表示越过圆角外扩了多远。
    // 用它把「可拖拽范围」限制在可见的圆角卡片上，而不是整个矩形窗口。
    function shoulder(offset: length, edge: length) -> float {
        return max(max(root.radius - offset, 0px), offset - (edge - root.radius)) / 1px;
    }
    function inside-card(px: length, py: length) -> bool {
        return root.shoulder(px, root.width) * root.shoulder(px, root.width)
            + root.shoulder(py, root.height) * root.shoulder(py, root.height)
            <= (root.radius / 1px) * (root.radius / 1px);
    }

    // 卡片铺满窗口：没有投影就不需要留白，圆角靠窗口的透明区域让出。
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: root.radius;
        background: @linear-gradient(
            155deg,
            dark ? rgba(44, 46, 54, 0.96) : rgba(255, 255, 255, 0.97),
            dark ? rgba(20, 21, 27, 0.90) : rgba(240, 242, 249, 0.90)
        );
        border-width: 1px;
        border-color: dark ? rgba(255, 255, 255, 0.16) : rgba(18, 20, 30, 0.10);

        // 顶缘高光：一层垂直淡出的白色渐变，模拟玻璃受光。
        Rectangle {
            border-radius: parent.border-radius;
            background: @linear-gradient(
                180deg,
                rgba(255, 255, 255, dark ? 0.12 : 0.55) 0%,
                rgba(255, 255, 255, 0.0) 40%
            );
        }

        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            alignment: center;
            spacing: 8px * root.k;

            HorizontalLayout {
                alignment: center;

                // 圆环 + 设备图标
                Rectangle {
                    width: 92px * root.k;
                    height: 92px * root.k;

                    // 底环
                    Path {
                        viewbox-width: 92;
                        viewbox-height: 92;
                        commands: "M 46 4 A 42 42 0 1 1 45.9 4 Z";
                        stroke: dark ? rgba(255, 255, 255, 0.16) : rgba(23, 24, 28, 0.10);
                        stroke-width: 6px * root.k;
                    }

                    // 进度弧：从 12 点方向顺时针画到 level 对应的角度。
                    Path {
                        viewbox-width: 92;
                        viewbox-height: 92;
                        commands: "M \{root.ring-c} \{root.ring-c - root.ring-r} A \{root.ring-r} \{root.ring-r} 0 \{root.level > 0.5 ? 1 : 0} 1 \{root.ring-end-x} \{root.ring-end-y}";
                        stroke: @linear-gradient(120deg, #6366f1, #a855f7);
                        stroke-width: 6px * root.k;
                        stroke-line-cap: round;
                    }

                    LucideImage {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        k: root.k;
                        ink: root.ink;
                    }
                }
            }

            Text {
                text: root.headline;
                font-size: 21px * root.k;
                font-weight: 700;
                color: root.ink;
                horizontal-alignment: center;
            }

            Text {
                text: root.caption;
                font-size: 10px * root.k;
                color: root.ink-dim;
                horizontal-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }
        }

        // 拖拽层覆盖整卡；落在圆角外的透明区域不响应。置于内容之上、手柄与按钮之下。
        TouchArea {
            mouse-cursor: root.inside-card(self.mouse-x, self.mouse-y) ? MouseCursor.move : MouseCursor.default;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    // 只有左键按在可见卡片内才进入拖拽；圆角外的透明区域不响应。
                    if (event.button == PointerEventButton.left
                        && root.inside-card(self.mouse-x, self.mouse-y)) {
                        root.dragging = true;
                        root.drag-begin();
                    }
                } else if (event.kind == PointerEventKind.up) {
                    if (root.dragging) {
                        root.dragging = false;
                        root.drag-end();
                    }
                } else if (event.kind == PointerEventKind.move) {
                    if (root.dragging) {
                        root.drag-move(self.mouse-x, self.mouse-y);
                    }
                }
            }
        }

        ResizeGrip {
            x: parent.width - self.width;
            y: parent.height - self.height;
            k: root.k;
            ink: root.ink-dim;
            grab() => { root.resize-begin(); }
            moved-to(x, y) => { root.resize-move(x, y); }
            release() => { root.resize-end(); }
        }

        CloseButton {
            x: 0;
            y: 0;
            k: root.k;
            ink: root.ink-dim;
            closed => { root.close-requested(); }
        }
    }
}
